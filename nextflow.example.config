/*
 * scFoundry -- Nextflow configuration template.
 *
 * `scfoundry init` copies this file into the workspace as nextflow.config and enables
 * the container runtime available on your machine. Edit that nextflow.config, not this
 * template, for server-specific settings.
 */

manifest {
    name            = 'scFoundry'
    description     = 'Deploy, run and evaluate single-cell foundation models'
    homePage        = 'https://github.com/Svvord/scFM-eval'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10'
}

// Where user data lives. `scfoundry` sets SCFOUNDRY_WORKSPACE to the workspace created by
// `scfoundry init`; when Nextflow is run directly from a development checkout the
// checkout itself is the workspace.
params {
    workspace_dir      = System.getenv('SCFOUNDRY_WORKSPACE') ?: "${projectDir}"
    bin_dir            = "${projectDir}/bin"                          // pipeline code, mounted as /code
    model_weights_dir  = "${params.workspace_dir}/data/model_weights" // mounted as /data/model_weights
    cache_dir          = "${params.workspace_dir}/cache"              // container images + Nextflow caches
    host_side_home_dir = "${params.workspace_dir}/cache/.home"        // HOME seen by the container
    envs_dir           = "${params.workspace_dir}/envs"
    gpu_id             = null                                         // e.g. "0" to pin one GPU; null = all visible
}

// Enable exactly ONE of docker / singularity / apptainer (scfoundry init does this).
docker {
    enabled = false
    runOptions = "--shm-size=16g " + (params.gpu_id ? "--gpus device=${params.gpu_id}" : "--gpus=all") + " -v ${params.bin_dir}:/code -v ${params.model_weights_dir}:/data/model_weights"
}

singularity {
    enabled = false
    pullTimeout = '6h'
    autoMounts = true
    runOptions = "--no-home --cleanenv --nv " + (params.gpu_id ? "--env CUDA_VISIBLE_DEVICES=${params.gpu_id} " : "") + "--bind ${params.model_weights_dir}:/data/model_weights --bind ${params.bin_dir}:/code --bind ${params.host_side_home_dir}:${System.getenv('HOME')}"
    cacheDir = "${params.cache_dir}/.shared/nxf_singularity"
}

apptainer {
    enabled = true
    pullTimeout = '6h'
    autoMounts = true
    runOptions = "--no-home --cleanenv --nv " + (params.gpu_id ? "--env CUDA_VISIBLE_DEVICES=${params.gpu_id} " : "") + "--bind ${params.model_weights_dir}:/data/model_weights --bind ${params.bin_dir}:/code --bind ${params.host_side_home_dir}:${System.getenv('HOME')}"
    cacheDir = "${params.cache_dir}/.shared/nxf_singularity"
}

conda {
    enabled = true
    useMamba = false
    cacheDir = "${params.cache_dir}/.shared/nxf_conda_envs"
    createOptions = '-y'
}

// Remove task work directories once a run completes successfully.
cleanup = true

// Optional: run GPU/CPU processes through a scheduler, e.g. `scfoundry embed ... --profile slurm`.
// Uncomment and adapt to your cluster.
// profiles {
//     slurm {
//         process.executor = 'slurm'
//         process { withLabel: 'gpu_task' { queue = 'gpu'; clusterOptions = '--gres=gpu:1'; time = '12h'; memory = '64 GB' } }
//         process { withLabel: 'cpu_task' { queue = 'day'; time = '4h'; memory = '32 GB' } }
//     }
// }
