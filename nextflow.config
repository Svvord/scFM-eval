params {
    envs_dir = "${projectDir}/envs"
    bin_dir = "${projectDir}/bin"
    model_weights_dir = "${projectDir}/data/model_weights"
    cache_dir = "${projectDir}/cache"
    host_side_home_dir = "${projectDir}/cache/.home"
}

docker {
    enabled = false
    runOptions = "--shm-size=16g --gpus=all -v ${params.bin_dir}:/code -v ${params.model_weights_dir}:/data/model_weights"
}

apptainer {
    enabled = true
    pullTimeout = '6h'
    autoMounts = true
    runOptions = "--no-home --cleanenv --nv --bind ${params.model_weights_dir}:/data/model_weights --bind ${params.bin_dir}:/code --bind ${params.host_side_home_dir}:${System.getenv('HOME')}"
    cacheDir = "${params.cache_dir}/.shared/nxf_singularity"
}

conda {
    enabled = true
    useMamba = false
    cacheDir = "${params.cache_dir}/.shared/nxf_conda_envs"
    createOptions = '-y'  // Auto-confirm package installation
}

process.cleanup = true